  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d68c91ba860f6d04cbd9464c07f0caa9, type: 3}
  m_Name: Arrival
  m_EditorClassIdentifier: Assembly-CSharp::JamKit.DialogueAsset
  lines:
  - speaker: "\u0420\u0430\u0441\u0441\u043A\u0430\u0437\u0447\u0438\u043A"
    portrait: {fileID: 0}
    text: "\u0417\u0430 \u0434\u0432\u0435\u0440\u044C\u044E \u0441\u0442\u0438\u0445
      \u0448\u0443\u043C. \u0412\u043F\u0435\u0440\u0435\u0434\u0438 \u2014 \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0439
      \u043F\u0443\u0442\u044C. \u042D\u0442\u043E \u043F\u0440\u0438\u043C\u0435\u0440
      \u0441\u044E\u0436\u0435\u0442\u043D\u043E\u0433\u043E \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u044F:
      \u0437\u0430\u043C\u0435\u043D\u0438 \u0435\u0433\u043E \u0441\u0432\u043E\u0435\u0439
      \u0438\u0441\u0442\u043E\u0440\u0438\u0435\u0439."
  - speaker: "\u0420\u0430\u0441\u0441\u043A\u0430\u0437\u0447\u0438\u043A"
    portrait: {fileID: 0}
    text: "\u0422\u0430\u043A\u0438\u0435 \u043E\u043A\u043D\u0430 \u043C\u043E\u0436\u043D\u043E
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u043F\u0440\u0438
      \u0432\u0445\u043E\u0434\u0435 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0443,
      \u0443 \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u043E\u0439 \u0437\u0430\u043F\u0438\u0441\u043A\u0438
      \u0438\u043B\u0438 \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u0436\u043D\u043E\u0439
      \u0432\u0441\u0442\u0440\u0435\u0447\u0435\u0439."
