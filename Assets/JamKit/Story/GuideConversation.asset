MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d68c91ba860f6d04cbd9464c07f0caa9, type: 3}
  m_Name: GuideConversation
  m_EditorClassIdentifier: Assembly-CSharp::JamKit.DialogueAsset
  lines:
  - speaker: "\u0421\u043C\u043E\u0442\u0440\u0438\u0442\u0435\u043B\u044C"
    portrait: {fileID: 0}
    text: "\u0422\u044B \u0437\u0434\u0435\u0441\u044C \u0432\u043F\u0435\u0440\u0432\u044B\u0435?
      \u041D\u0435 \u0441\u043F\u0435\u0448\u0438. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
      \u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0441\u044C."
  - speaker: "\u041F\u0443\u0442\u043D\u0438\u043A"
    portrait: {fileID: 0}
    text: "\u0427\u0442\u043E \u0436\u0434\u0451\u0442 \u043C\u0435\u043D\u044F \u0434\u0430\u043B\u044C\u0448\u0435?"
  - speaker: "\u0421\u043C\u043E\u0442\u0440\u0438\u0442\u0435\u043B\u044C"
    portrait: {fileID: 0}
    text: "\u041F\u043E\u043A\u0430 \u044D\u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E
      \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430.
      \u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043C\u0435\u043D\u044F\u0442\u044C
      \u0438\u043C\u0435\u043D\u0430, \u043F\u043E\u0440\u0442\u0440\u0435\u0442\u044B
      \u0438 \u0440\u0435\u043F\u043B\u0438\u043A\u0438, \u0430 \u043F\u043E\u0442\u043E\u043C
      \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0432\u043E\u043A\u0440\u0443\u0433
      \u043D\u0438\u0445 \u0441\u0432\u043E\u044E \u0438\u0441\u0442\u043E\u0440\u0438\u044E."
